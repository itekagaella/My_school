# ============================================================
# My_School - Configuration PostgreSQL
# Copiez ce fichier en « .env » et adaptez les valeurs.
#     Windows (PowerShell) :  copy .env.example .env
#     Linux / macOS         :  cp .env.example .env
# ============================================================

# --- Connexion PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=my_school
DB_USER=postgres
DB_PASSWORD=postgres

# --- Clé de chiffrement de l'application ---
# Générez une valeur unique, par exemple :
#     php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=changez_cette_cle_secrete_chaque_production

# --- Emails (notifications, 2FA, mots de passe oubliés) ---
# Transport :
#   log  = mode démo : aucun envoi, les emails sont archivés dans storage/mail/
#          et consultables dans Admin > Journal > Boîte email (gratuit, hors-ligne)
#   smtp = envoi réel via SMTP (Brevo gratuit 300/jour, Gmail, Mailpit, hébergeur…)
#   mail = fonction mail() de PHP (déconseillé sous Windows)
MAIL_TRANSPORT=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
# none | tls (STARTTLS, 587) | ssl (TLS direct, 465)
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@myschool.edu
MAIL_FROM_NAME=My_School
MAIL_TIMEOUT=10

# true : affiche à l'écran les codes OTP / liens de réinitialisation lorsque
#        aucun SMTP n'est configuré (à activer uniquement pour une démo locale)
DEMO_LINKS=false

# Jeton secret pour lancer le traitement de la file d'emails par URL
# (Planificateur de tâches Windows, cron…). Générez une valeur aléatoire :
#     php -r "echo bin2hex(random_bytes(24));"
CRON_TOKEN=
