# ============================================================
# My_School - Configuration PostgreSQL
# Copiez ce fichier en « .env » et adaptez les valeurs.
#     Windows (PowerShell) :  copy .env.example .env
#     Linux / macOS         :  cp .env.example .env
# ============================================================

# --- Connexion PostgreSQL ---
# Avec Docker : laissez tel quel (docker-compose fournit déjà ces valeurs).
# Sans Docker, PostgreSQL local : 127.0.0.1 / 5432
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=my_school
DB_USER=postgres
DB_PASSWORD=postgres

# --- Clé de chiffrement de l'application ---
# Générez une valeur unique, par exemple :
#     php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=changez_cette_cle_secrete_chaque_production
