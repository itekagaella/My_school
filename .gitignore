# Artefacts temporaires
.~lock.*.docx#
*.docx#
Thumbs.db
.DS_Store

# Fichiers de configuration locaux / secrets
.env
*.local

# Marqueur d'installation (généré par install.php)
config/.installed

# Journal / logs
*.log

# Sauvegardes générées
admin/parametres/*.sql
*.dump
*.sql.gz

# Fichiers uploadés (contenu binaire/privé)
assets/uploads/*
!assets/uploads/.htaccess
uploads/

# Emails de démo (boîte locale, contenus privés)
storage/mail/*
!storage/mail/.gitkeep

# IDE
.idea/
.vscode/
*.swp

# Sauvegardes SQL locales (contenus privés)
storage/backups/*
!storage/backups/.gitkeep
