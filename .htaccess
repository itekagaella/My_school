# My_School - Configuration Apache

Options -Indexes
DirectoryIndex index.php

# Encodage par défaut (évite les accents « Ã© » sous Apache)
AddDefaultCharset UTF-8

# Protection des fichiers sensibles
<FilesMatch "\.(sql|log|ini|htaccess|env)$">
    Require all denied
</FilesMatch>

# Redirection vers HTTPS (décommenter en production)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Empêcher l'accès aux fichiers de configuration
RewriteEngine On
RewriteRule ^config(/|$) - [F,L]
RewriteRule ^includes(/|$) - [F,L]

# En-têtes de sécurité
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Désactiver l'affichage des erreurs en production
php_flag display_errors Off
php_value error_reporting E_ALL
php_flag output_buffering On

# En-têtes de sécurité supplémentaires
<IfModule mod_headers.c>
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP basique - ajuster si besoin pour Chart.js, Google Fonts locaux, etc.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    # HSTS (activer uniquement si HTTPS)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
