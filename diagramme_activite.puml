@startuml Diagramme_Activite_My_School

title Diagramme d'activités - My_School (Système de Gestion Scolaire)

' === STYLE ===
skinparam backgroundColor #FFFFFF
skinparam activity {
  StartColor #2F9C5D
  EndColor #D64545
  BarColor #3B82F6
  BorderColor #1E293B
  ArrowColor #475569
}

' === ACTEUR 1: AUTHENTIFICATION ET CONNEXION ===
|Utilisateur|
start
:Accéder à la page de connexion;
if (Compte déjà connecté ?) then (oui)
  :Rediriger vers tableau de bord selon rôle;
else (non)
  :Saisir identifiants (email/mot de passe);
  if (Vérification des identifiants) then (invalide)
    :Afficher erreur;
    stop
  else (valide)
    if (Vérification 2FA activée ?) then (oui)
      :Saisir code de vérification 2FA;
      if (Code valide ?) then (non)
        :Afficher erreur 2FA;
        stop
      else (oui)
      endif
    endif
    :Créer session et enregistrer historique;
    :Rediriger vers tableau de bord selon rôle;
  endif
endif

' === ACTEUR 2: ADMINISTRATEUR ===
|Administrateur|
if (Rôle = Administrateur) then (oui)
  fork
    :Gérer utilisateurs (élèves/profs/personnel/roles);
  fork again
    :Gérer classes, matières, salles;
  fork again
    :Gérer emploi du temps;
  fork again
    :Gérer documents et commentaires;
  fork again
    :Gérer finances (frais/paiements/reçus);
  fork again
    :Gérer discipline (incidents/sanctions/convocations);
  fork again
    :Gérer communications et chat;
  fork again
    :Générer rapports/exports PDF-Excel;
  fork again
    :Configurer paramètres/établissement/logo;
  fork again
    :Sauvegarde base de données;
  end fork
endif

' === ACTEUR 3: PROFESSEUR ===
|Professeur|
if (Rôle = Professeur) then (oui)
  fork
    :Consulter emploi du temps;
  fork again
    :Gérer mes élèves;
  fork again
    :Saisir notes par évaluation;
    :Calcul automatique des moyennes;
  fork again
    :Enregistrer présences/absences;
  fork again
    :Gérer documents pédagogiques;
  fork again
    :Communiquer via chat/communications;
  end fork
endif

' === ACTEUR 4: ÉLÈVE ===
|Élève|
if (Rôle = Élève) then (oui)
  fork
    :Consulter emploi du temps;
  fork again
    :Consulter mes notes et bulletins;
  fork again
    :Consulter mes présences/absences;
  fork again
    :Consulter mes paiements/solde/reçus;
  fork again
    :Consulter discipline (incidents/sanctions);
  fork again
    :Consulter documents/communications;
  fork again
    :Participer aux clubs;
  fork again
    :Discuter via chat;
  end fork
endif

' === ACTEUR 5: PERSONNEL (SURVEILLANT/FINANCE/DISCIPLINE) ===
|Personnel|
if (Rôle = Surveillant/Finance/Discipline/Personnel) then (oui)
  fork
    :Surveillant - Enregistrer présences/incidents;
  fork again
    :Finance - Gérer frais/paiements (espèces)/rapports;
  fork again
    :Discipline - Gérer incidents/sanctions/convocations;
  fork again
    :Consulter élèves/classes selon permissions;
  fork again
    :Gérer communications/documents selon rôle;
  end fork
endif

' === NOTIFICATIONS ET DÉCONNEXION ===
|Tous les utilisateurs|
:Recevoir notifications;
if (Cliquer sur notification) then (oui)
  :Marquer comme lu et rediriger vers lien;
endif
:Déconnexion manuelle ou automatique (inactivité);
:Destruction de session et redirection vers page de connexion;
stop

@enduml
