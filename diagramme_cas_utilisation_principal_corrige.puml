@startuml Diagramme_Cas_Utilisation_Principal

title Diagramme de cas d'utilisation principal - My_School

left to right direction

skinparam actorStyle awesome

actor Administrateur as Admin
actor Professeur as Prof
actor Élève as Eleve
actor Surveillant as Surv
actor "Gestionnaire Financier" as Finance
actor "Responsable Discipline" as Disc

rectangle "My_School" {
  usecase "S'authentifier" as UC_Auth
  usecase "S'authentifier avec 2FA" as UC_2FA
  
  usecase "Gérer les utilisateurs" as UC_Users
  usecase "Gérer les classes et matières" as UC_Classes
  usecase "Gérer l'emploi du temps" as UC_EDT_Gest
  usecase "Gérer les paramètres" as UC_Param
  usecase "Gérer les documents" as UC_Docs_Admin
  usecase "Générer des rapports" as UC_Rapports
  usecase "Effectuer une sauvegarde" as UC_Save
  
  usecase "Saisir les notes" as UC_Notes
  usecase "Gérer les présences" as UC_Pres
  usecase "Consulter l'emploi du temps" as UC_EDT_Cons
  
  usecase "Consulter mes notes" as UC_MesNotes
  usecase "Consulter mes bulletins" as UC_Bulletin
  usecase "Consulter mes paiements" as UC_MesPaiements
  usecase "Consulter ma discipline" as UC_MaDiscipline
  
  usecase "Gérer les frais scolaires" as UC_Frais
  usecase "Enregistrer les paiements" as UC_Paiement
  usecase "Générer les reçus" as UC_Reçu
  usecase "Suivre les soldes" as UC_Solde
  
  usecase "Gérer les incidents" as UC_Incident
  usecase "Gérer les sanctions" as UC_Sanction
  usecase "Gérer les convocations" as UC_Convoc
  usecase "Enregistrer les présences" as UC_PresSurv
  
  usecase "Envoyer / Répondre aux messages" as UC_Chat
  usecase "Consulter les notifications" as UC_Notif
  usecase "Gérer son profil" as UC_Profil
}

' Authentification
Admin --> UC_Auth
Prof --> UC_Auth
Eleve --> UC_Auth
Surv --> UC_Auth
Finance --> UC_Auth
Disc --> UC_Auth

UC_Auth <|-- UC_2FA

' Administrateur
Admin --> UC_Users
Admin --> UC_Classes
Admin --> UC_EDT_Gest
Admin --> UC_Param
Admin --> UC_Docs_Admin
Admin --> UC_Rapports
Admin --> UC_Save
Admin --> UC_Chat
Admin --> UC_Notif
Admin --> UC_Profil

' Professeur
Prof --> UC_EDT_Cons
Prof --> UC_Notes
Prof --> UC_Pres
Prof --> UC_Chat
Prof --> UC_Notif
Prof --> UC_Profil

' Élève
Eleve --> UC_EDT_Cons
Eleve --> UC_MesNotes
Eleve --> UC_Bulletin
Eleve --> UC_MesPaiements
Eleve --> UC_MaDiscipline
Eleve --> UC_Chat
Eleve --> UC_Notif
Eleve --> UC_Profil

' Surveillant
Surv --> UC_EDT_Cons
Surv --> UC_PresSurv
Surv --> UC_Incident
Surv --> UC_Chat
Surv --> UC_Notif
Surv --> UC_Profil

' Gestionnaire Financier
Finance --> UC_Frais
Finance --> UC_Paiement
Finance --> UC_Reçu
Finance --> UC_Solde
Finance --> UC_Chat
Finance --> UC_Notif
Finance --> UC_Profil

' Responsable Discipline
Disc --> UC_Incident
Disc --> UC_Sanction
Disc --> UC_Convoc
Disc --> UC_Chat
Disc --> UC_Notif
Disc --> UC_Profil

UC_2FA ..> UC_Auth : <<extend>>
UC_Profil ..> UC_Auth : <<include>>

@enduml
