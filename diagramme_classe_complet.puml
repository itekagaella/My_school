@startuml My_School_Diagramme_Classes

title DIAGRAMME DE CLASSES - My_School\nSystème de Gestion Scolaire

skinparam classAttributeIconSize 0
skinparam classFontSize 9
skinparam packageStyle rectangle
skinparam linetype ortho

' ==================== AUTHENTIFICATION & SECURITE ====================
package "Authentification & Sécurité" as Auth {
  class Utilisateurs {
    - id : INTEGER <<PK>>
    - nom : VARCHAR(100) <<NOT NULL>>
    - prenom : VARCHAR(100) <<NOT NULL>>
    - email : VARCHAR(150) <<UNIQUE, NOT NULL>>
    - password_hash : VARCHAR(255) <<NOT NULL>>
    - role : VARCHAR(20) <<CHECK(admin,eleve,prof,personnel,surveillant,finance,discipline)>>
    - avatar : VARCHAR(255)
    - actif : BOOLEAN = TRUE
    - deux_facteurs : BOOLEAN = FALSE
    - dernier_code_otp : VARCHAR(255)
    - dernier_code_exp : TIMESTAMP
    - derniere_connexion : TIMESTAMP
    - tentatives_connexion : INTEGER = 0
    - compte_verrouille : BOOLEAN = FALSE
    - verrou_date : TIMESTAMP
    - created_at : TIMESTAMP = NOW()
    - updated_at : TIMESTAMP = NOW()
  }

  class Roles {
    - id : INTEGER <<PK>>
    - nom_role : VARCHAR(50) <<UNIQUE, NOT NULL>>
    - description : TEXT
    - created_at : TIMESTAMP = NOW()
  }

  class Permissions {
    - id : INTEGER <<PK>>
    - nom_permission : VARCHAR(100) <<UNIQUE, NOT NULL>>
    - description : TEXT
    - created_at : TIMESTAMP = NOW()
  }

  class Role_Permissions {
    - role_id : INTEGER <<PK, FK>>
    - permission_id : INTEGER <<PK, FK>>
  }

  class Sessions_Utilisateur {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK, NOT NULL>>
    - token : VARCHAR(255) <<UNIQUE, NOT NULL>>
    - ip_address : VARCHAR(45) <<NOT NULL>>
    - user_agent : TEXT
    - expires_at : TIMESTAMP <<NOT NULL>>
    - created_at : TIMESTAMP = NOW()
  }

  class Historique_Connexions {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK>>
    - ip_address : VARCHAR(45) <<NOT NULL>>
    - user_agent : TEXT
    - date_connexion : TIMESTAMP = NOW()
    - succes : BOOLEAN <<NOT NULL>>
    - raison : VARCHAR(255)
  }

  class Journal_Activites {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK>>
    - action : VARCHAR(100) <<NOT NULL>>
    - details : TEXT
    - ip_address : VARCHAR(45)
    - date_action : TIMESTAMP = NOW()
  }

  class Password_Resets {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK, NOT NULL>>
    - token : VARCHAR(255) <<UNIQUE, NOT NULL>>
    - expires_at : TIMESTAMP <<NOT NULL>>
    - used : BOOLEAN = FALSE
    - created_at : TIMESTAMP = NOW()
  }
}

' ==================== STRUCTURE SCOLAIRE ====================
package "Structure Scolaire" as Ecole {
  class Classes {
    - id : INTEGER <<PK>>
    - nom_classe : VARCHAR(50) <<NOT NULL>>
    - niveau : VARCHAR(50) <<NOT NULL>>
    - section : VARCHAR(50)
    - annee_scolaire : VARCHAR(9) <<NOT NULL>>
    - capacite : INTEGER = 50
    - created_at : TIMESTAMP = NOW()
  }

  class Salles {
    - id : INTEGER <<PK>>
    - numero : INTEGER
    - nom : VARCHAR(80) <<UNIQUE, NOT NULL>>
    - type : VARCHAR(20) <<CHECK(classe,administratif), NOT NULL>>
    - classe_id : INTEGER <<FK, UNIQUE>>
    - actif : BOOLEAN = TRUE
    - created_at : TIMESTAMP = NOW()
  }

  class Matieres {
    - id : INTEGER <<PK>>
    - code_matiere : VARCHAR(20) <<UNIQUE, NOT NULL>>
    - nom_matiere : VARCHAR(100) <<NOT NULL>>
    - coefficient : DECIMAL(4,2) = 1.00
    - classe_id : INTEGER <<FK>>
    - niveau_cible : VARCHAR(80)
    - description : TEXT
    - created_at : TIMESTAMP = NOW()
  }
}

' ==================== PERSONNEL & ELEVES ====================
package "Acteurs" as Acteurs {
  class Eleves {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK, UNIQUE>>
    - matricule : VARCHAR(20) <<UNIQUE, NOT NULL>>
    - nom : VARCHAR(100) <<NOT NULL>>
    - prenom : VARCHAR(100) <<NOT NULL>>
    - date_naissance : DATE <<NOT NULL>>
    - sexe : VARCHAR(1) <<CHECK(M,F), NOT NULL>>
    - classe_id : INTEGER <<FK>>
    - parent_nom : VARCHAR(200)
    - parent_tel : VARCHAR(20)
    - parent_email : VARCHAR(150)
    - adresse : TEXT
    - photo : VARCHAR(255)
    - statut : VARCHAR(20) = 'actif' <<CHECK(actif,inactif,archive)>>
    - created_at : TIMESTAMP = NOW()
    - updated_at : TIMESTAMP = NOW()
  }

  class Profs {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK, UNIQUE>>
    - matricule : VARCHAR(20) <<UNIQUE, NOT NULL>>
    - nom : VARCHAR(100) <<NOT NULL>>
    - prenom : VARCHAR(100) <<NOT NULL>>
    - specialite : VARCHAR(100)
    - tel : VARCHAR(20)
    - email : VARCHAR(150)
    - adresse : TEXT
    - photo : VARCHAR(255)
    - statut : VARCHAR(20) = 'actif' <<CHECK(actif,inactif,archive)>>
    - created_at : TIMESTAMP = NOW()
    - updated_at : TIMESTAMP = NOW()
  }

  class Personnel {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK, UNIQUE>>
    - matricule : VARCHAR(20) <<UNIQUE, NOT NULL>>
    - nom : VARCHAR(100) <<NOT NULL>>
    - prenom : VARCHAR(100) <<NOT NULL>>
    - fonction : VARCHAR(100)
    - tel : VARCHAR(20)
    - email : VARCHAR(150)
    - statut : VARCHAR(20) = 'actif' <<CHECK(actif,inactif,archive)>>
    - created_at : TIMESTAMP = NOW()
  }
}

' ==================== PEDAGOGIE ====================
package "Pédagogie" as Pedagogie {
  class Horaires {
    - id : INTEGER <<PK>>
    - classe_id : INTEGER <<FK, NOT NULL>>
    - matiere_id : INTEGER <<FK, NOT NULL>>
    - prof_id : INTEGER <<FK, NOT NULL>>
    - salle_id : INTEGER <<FK>>
    - jour : VARCHAR(10) <<CHECK(lundi,mardi,mercredi,jeudi,vendredi,samedi), NOT NULL>>
    - heure_debut : TIME <<NOT NULL>>
    - heure_fin : TIME <<NOT NULL>>
    - salle : VARCHAR(80)
    - statut : VARCHAR(20) = 'brouillon' <<CHECK(brouillon,publie,annule)>>
    - annee_scolaire : VARCHAR(9)
    - created_at : TIMESTAMP = NOW()
    - updated_at : TIMESTAMP = NOW()
  }

  class Notes {
    - id : INTEGER <<PK>>
    - eleve_id : INTEGER <<FK, NOT NULL>>
    - matiere_id : INTEGER <<FK, NOT NULL>>
    - prof_id : INTEGER <<FK, NOT NULL>>
    - note : DECIMAL(4,2) <<NOT NULL>>
    - type_evaluation : VARCHAR(20) <<CHECK(interrogation,controle,devoir,composition)>>
    - periode : VARCHAR(20)
    - coefficient : DECIMAL(3,2) = 1.00
    - date_evaluation : DATE <<NOT NULL>>
    - appreciation : TEXT
    - created_at : TIMESTAMP = NOW()
  }

  class Presences {
    - id : INTEGER <<PK>>
    - eleve_id : INTEGER <<FK, NOT NULL>>
    - horaire_id : INTEGER <<FK>>
    - prof_id : INTEGER <<FK>>
    - date_presence : DATE <<NOT NULL>>
    - statut : VARCHAR(15) <<CHECK(present,absent,retard,justifie), NOT NULL>>
    - heure_arrivee : TIME
    - motif : TEXT
    - justifie : BOOLEAN = FALSE
    - justifie_par : INTEGER <<FK>>
    - date_justification : TIMESTAMP
    - created_at : TIMESTAMP = NOW()
  }
}

' ==================== FINANCES ====================
package "Finances" as Finances {
  class Frais_Scolaires {
    - id : INTEGER <<PK>>
    - libelle : VARCHAR(150) <<NOT NULL>>
    - description : TEXT
    - montant : DECIMAL(12,2) <<NOT NULL>>
    - niveau : VARCHAR(80)
    - annee_scolaire : VARCHAR(9) <<NOT NULL>>
    - obligatoire : BOOLEAN = TRUE
    - actif : BOOLEAN = TRUE
    - created_at : TIMESTAMP = NOW()
    - updated_at : TIMESTAMP = NOW()
  }

  class Paiements {
    - id : INTEGER <<PK>>
    - eleve_id : INTEGER <<FK, NOT NULL>>
    - frais_id : INTEGER <<FK>>
    - montant : DECIMAL(12,2) <<NOT NULL>>
    - periode : VARCHAR(40)
    - date_paiement : DATE = CURRENT_DATE
    - mode_paiement : VARCHAR(20) = 'especes' <<CHECK(especes)>>
    - reference : VARCHAR(100)
    - recu_numero : VARCHAR(30) <<UNIQUE, NOT NULL>>
    - observation : TEXT
    - enregistre_par : INTEGER <<FK>>
    - created_at : TIMESTAMP = NOW()
  }
}

' ==================== DISCIPLINE ====================
package "Discipline" as Discipline {
  class Incidents_Discipline {
    - id : INTEGER <<PK>>
    - eleve_id : INTEGER <<FK, NOT NULL>>
    - date_incident : DATE = CURRENT_DATE
    - type_incident : VARCHAR(80) <<NOT NULL>>
    - gravite : VARCHAR(20) = 'moyenne' <<CHECK(faible,moyenne,grave)>>
    - description : TEXT
    - lieu : VARCHAR(120)
    - signale_par : INTEGER <<FK>>
    - statut : VARCHAR(20) = 'ouvert' <<CHECK(ouvert,traite,clos)>>
    - created_at : TIMESTAMP = NOW()
    - updated_at : TIMESTAMP = NOW()
  }

  class Sanctions {
    - id : INTEGER <<PK>>
    - eleve_id : INTEGER <<FK, NOT NULL>>
    - incident_id : INTEGER <<FK>>
    - type_sanction : VARCHAR(80) <<NOT NULL>>
    - description : TEXT
    - date_debut : DATE = CURRENT_DATE
    - date_fin : DATE
    - statut : VARCHAR(20) = 'active' <<CHECK(active,terminee,annulee)>>
    - prononce_par : INTEGER <<FK>>
    - created_at : TIMESTAMP = NOW()
  }

  class Convocations {
    - id : INTEGER <<PK>>
    - eleve_id : INTEGER <<FK, NOT NULL>>
    - date_convocation : TIMESTAMP <<NOT NULL>>
    - lieu : VARCHAR(150)
    - motif : TEXT <<NOT NULL>>
    - objet : VARCHAR(200)
    - convoque_par : INTEGER <<FK>>
    - statut : VARCHAR(20) = 'envoyee' <<CHECK(envoyee,vue,traitee)>>
    - date_envoi : TIMESTAMP = NOW()
  }
}

' ==================== COMMUNICATION & AUTRES ====================
package "Communication" as Com {
  class Communications {
    - id : INTEGER <<PK>>
    - auteur_id : INTEGER <<FK, NOT NULL>>
    - titre : VARCHAR(200) <<NOT NULL>>
    - contenu : TEXT <<NOT NULL>>
    - type : VARCHAR(20) <<CHECK(general,classe,individuel)>>
    - destinataires : JSONB
    - classe_id : INTEGER <<FK>>
    - priorite : VARCHAR(10) = 'normale' <<CHECK(normale,importante,urgente)>>
    - date_publication : TIMESTAMP = NOW()
    - date_expiration : TIMESTAMP
    - actif : BOOLEAN = TRUE
  }

  class Documents {
    - id : INTEGER <<PK>>
    - titre : VARCHAR(200) <<NOT NULL>>
    - description : TEXT
    - fichier : VARCHAR(255) <<NOT NULL>>
    - nom_original : VARCHAR(255)
    - type_fichier : VARCHAR(50)
    - taille : INTEGER
    - categorie : VARCHAR(50)
    - auteur_id : INTEGER <<FK>>
    - classe_id : INTEGER <<FK>>
    - partage_public : BOOLEAN = FALSE
    - telechargements : INTEGER = 0
    - created_at : TIMESTAMP = NOW()
  }

  class Clubs {
    - id : INTEGER <<PK>>
    - nom_club : VARCHAR(100) <<NOT NULL>>
    - description : TEXT
    - responsable : VARCHAR(150)
    - logo : VARCHAR(255)
    - actif : BOOLEAN = TRUE
    - created_at : TIMESTAMP = NOW()
  }

  class Club_Membres {
    - id : INTEGER <<PK>>
    - club_id : INTEGER <<FK, NOT NULL>>
    - eleve_id : INTEGER <<FK, NOT NULL>>
    - date_inscription : TIMESTAMP = NOW()
    - role : VARCHAR(20) = 'membre' <<CHECK(membre,responsable)>>
  }

  class Messages_Chat {
    - id : INTEGER <<PK>>
    - sender_id : INTEGER <<FK, NOT NULL>>
    - receiver_id : INTEGER <<FK, NOT NULL>>
    - message : TEXT <<NOT NULL>>
    - lu : BOOLEAN = FALSE
    - date_envoi : TIMESTAMP = NOW()
  }

  class Notifications {
    - id : INTEGER <<PK>>
    - user_id : INTEGER <<FK, NOT NULL>>
    - titre : VARCHAR(150) <<NOT NULL>>
    - message : TEXT <<NOT NULL>>
    - type : VARCHAR(30)
    - lien : VARCHAR(255)
    - lu : BOOLEAN = FALSE
    - date_envoi : TIMESTAMP = NOW()
  }
}

' ==================== SYSTEME ====================
package "Système" as Systeme {
  class Parametres_Systeme {
    - id : INTEGER <<PK>>
    - cle : VARCHAR(100) <<UNIQUE, NOT NULL>>
    - valeur : TEXT
    - description : TEXT
    - updated_at : TIMESTAMP = NOW()
  }

  class Themes {
    - id : INTEGER <<PK>>
    - nom_theme : VARCHAR(50) <<NOT NULL>>
    - css_path : VARCHAR(100) <<NOT NULL>>
    - actif : BOOLEAN = FALSE
    - created_at : TIMESTAMP = NOW()
  }

  class Sauvegardes {
    - id : INTEGER <<PK>>
    - nom_fichier : VARCHAR(255) <<NOT NULL>>
    - chemin : VARCHAR(500)
    - taille : BIGINT
    - type : VARCHAR(20) = 'manuel' <<CHECK(auto,manuel)>>
    - date_sauvegarde : TIMESTAMP = NOW()
    - effectuee_par : INTEGER <<FK>>
  }

  class Archives {
    - id : INTEGER <<PK>>
    - table_source : VARCHAR(50) <<NOT NULL>>
    - record_id : INTEGER <<NOT NULL>>
    - donnees_json : JSONB
    - date_archive : TIMESTAMP = NOW()
    - archive_par : INTEGER <<FK>>
  }
}

' ==================== RELATIONS ====================

' Auth
Utilisateurs "1" -- "0..1" Eleves
Utilisateurs "1" -- "0..1" Profs
Utilisateurs "1" -- "0..1" Personnel
Utilisateurs "1" -- "*" Sessions_Utilisateur
Utilisateurs "1" -- "*" Historique_Connexions
Utilisateurs "1" -- "*" Journal_Activites
Utilisateurs "1" -- "*" Password_Resets
Roles "1" -- "*" Role_Permissions
Permissions "1" -- "*" Role_Permissions
Utilisateurs "*" -- "1" Roles : role

' Structure
Classes "1" -- "*" Eleves
Classes "1" -- "*" Matieres
Classes "1" -- "*" Horaires
Classes "0..1" -- "1" Salles

' Pédagogie
Eleves "1" -- "*" Notes
Matieres "1" -- "*" Notes
Profs "1" -- "*" Notes
Profs "1" -- "*" Horaires
Matieres "1" -- "*" Horaires
Salles "0..1" -- "*" Horaires
Eleves "1" -- "*" Presences
Horaires "0..1" -- "*" Presences
Profs "0..1" -- "*" Presences
Utilisateurs "0..1" -- "*" Presences : justifie_par

' Finances
Eleves "1" -- "*" Paiements
Frais_Scolaires "0..1" -- "*" Paiements
Utilisateurs "0..1" -- "*" Paiements : enregistre_par

' Discipline
Eleves "1" -- "*" Incidents_Discipline
Utilisateurs "0..1" -- "*" Incidents_Discipline : signale_par
Incidents_Discipline "0..1" -- "1" Sanctions
Eleves "1" -- "*" Sanctions
Utilisateurs "0..1" -- "*" Sanctions : prononce_par
Eleves "1" -- "*" Convocations
Utilisateurs "0..1" -- "*" Convocations : convoque_par

' Communication
Utilisateurs "1" -- "*" Communications : auteur_id
Classes "0..1" -- "*" Communications
Utilisateurs "0..1" -- "*" Documents : auteur_id
Classes "0..1" -- "*" Documents
Clubs "1" -- "*" Club_Membres
Eleves "1" -- "*" Club_Membres
Utilisateurs "1" -- "*" Messages_Chat : sender_id
Utilisateurs "1" -- "*" Messages_Chat : receiver_id
Utilisateurs "1" -- "*" Notifications

' Système
Utilisateurs "0..1" -- "*" Sauvegardes : effectuee_par
Utilisateurs "0..1" -- "*" Archives : archive_par

@enduml
